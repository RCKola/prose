# Copy this file to `.env` and fill in the values.
#   cp .env.example .env
# `.env` is gitignored. It is auto-loaded by scripts/run_pipeline.py.

# -----------------------------------------------------------------------------
# HuggingFace token (required for gated repos: facebook/sam3, Qwen, ...)
# -----------------------------------------------------------------------------
# Create one at https://huggingface.co/settings/tokens (Read scope). Accept the
# SAM3 license at https://huggingface.co/facebook/sam3 first.
HF_TOKEN=

# Where HuggingFace caches model weights (keeps them inside the repo).
HF_HOME=./weights

# -----------------------------------------------------------------------------
# VGGT-Omega checkpoint (gated; only needed for use_gt_pointclouds=false)
# -----------------------------------------------------------------------------
# Download once from https://huggingface.co/facebook/VGGT-Omega and point this
# at the local .pt file. Overrides geometry.checkpoint_path.
# VGGT_OMEGA_CKPT=/data/weights/vggt_omega/vggt_omega_1b_512.pt

# -----------------------------------------------------------------------------
# Dataset root (overrides the hydra default without editing configs)
# -----------------------------------------------------------------------------
# ADT_ROOT=/data/adt

# -----------------------------------------------------------------------------
# Runtime tweaks
# -----------------------------------------------------------------------------
# CUDA_VISIBLE_DEVICES=0
PYTHONIOENCODING=utf-8
